# Create a copy named .env and put your own Gemini API key here.
GEMINI_API_KEY=PASTE_YOUR_API_KEY_HERE

# Current model used by the app. You can change this if your account supports another model.
GEMINI_MODEL=gemini-3.8-flash

# Keep "gemini" for the easiest lightweight setup.
# Set to "lamini" only after installing the optional local-model dependencies.
LOCAL_EXPLAINER=gemini
